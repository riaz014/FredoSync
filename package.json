{
  "name": "fredo-cloud",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "install:all": "npm ci && npm ci --prefix apps/api && npm ci --prefix apps/web",
    "build:backend": "npm ci && npm ci --prefix apps/api && npm run build --prefix apps/api",
    "build:frontend": "npm ci && npm ci --prefix apps/web && npm run build --prefix apps/web"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "turbo": "^1.10.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "next-themes": "^0.4.6",
    "tailwindcss-animate": "^1.0.7"
  }
}
